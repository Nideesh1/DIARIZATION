# Copy to demo/.env and fill in. demo/.env is gitignored; never commit it.

# The ASR + diarization service on the GPU box, over the LAN.
ASR_URL=http://192.168.0.247:9100

# Live captions while recording: the streaming ASR service on the same box (same token).
# The ui proxies it at /ws/live, so the token stays server side.
ASR_STREAM_URL=ws://192.168.0.247:9101/v1/stream

# Bearer token: the ASR_TOKEN= value from asr.env on the GPU box.
ASR_TOKEN=

# Timezone for the timestamps in the list (compose passes it to the containers).
TZ=America/New_York
